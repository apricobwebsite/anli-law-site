---
import '../styles/global.css';
import { LAW, SITE } from '../lib/site';
import { t, homePath, insightsPath, legalPath, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
  title: string;
  description?: string;
  /** 本頁在另一語言的網址（語言切換與 hreflang 用） */
  altPath: string;
  ogType?: string;
}

const { lang, title, description, altPath, ogType = 'website' } = Astro.props;
const home = homePath(lang);
const currentPath = Astro.url.pathname;
const zhHref = lang === 'zh' ? currentPath : altPath;
const enHref = lang === 'en' ? currentPath : altPath;
---

<!doctype html>
<html lang={lang === 'zh' ? 'zh-Hant-TW' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={t(lang, LAW.firm.full)} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" hreflang="zh-Hant" href={zhHref} />
    <link rel="alternate" hreflang="en" href={enHref} />
    {/*
      進場動畫的初始隱藏狀態交給 CSS（global.css 的 .reveal-js [data-reveal]）。這支 script
      必須是 inline 且在首次繪製前執行，否則內容會先畫出來再被抹掉。不支援 ES module 的
      瀏覽器（底下那支 module script 不會執行）與偏好減少動態者一律跳過，內容直接顯示。
    */}
    <script is:inline>
      if (
        'noModule' in HTMLScriptElement.prototype &&
        !window.matchMedia('(prefers-reduced-motion: reduce)').matches
      ) {
        document.documentElement.classList.add('reveal-js');
      }
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    {/*
      這支 stylesheet 是 render-blocking，字重寫法直接決定它多大：css2 API 會把
      「每個 weight × 每個 unicode-range subset」展開成獨立 @font-face，CJK 家族用列舉
      字重會炸成數百條規則。可變字型改用 wght@a..b 區間語法，woff2 檔完全相同（本來就是
      同一組可變字型檔），但規則數與 CSS 體積少一個量級：897 條 / 271KB → 128 條 / 34KB。
      Noto Serif TC 全站沒有任何元素使用（見 global.css 的 --font-serif），已移除。
      新增字重／家族前先確認實際有人用，這裡每一項都是首屏的阻塞成本。
    */}
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@400..900&family=Cormorant+Garamond:wght@600&family=Noto+Sans+TC:wght@400..900&family=IBM+Plex+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <slot name="head" />
  </head>
  <body>
    <nav class="site-nav">
      <a href={home} class="brand">
        <img class="brand-logo" src="/assets/logo-mark.svg" alt="" width="366" height="220" />
        <span class="brand-text">
          <span class="brand-zh">{LAW.firm.full.zh}</span>
          <span class="brand-en">{LAW.firm.full.en}</span>
        </span>
      </a>

      <div class="nav-desktop">
        <a class="nav-link" href={`${home}#principal`}>{t(lang, LAW.nav.principal)}</a>
        <a class="nav-link" href={`${home}#team`}>{t(lang, LAW.nav.team)}</a>
        <a class="nav-link" href={`${home}#practice`}>{t(lang, LAW.nav.practice)}</a>
        <a class="nav-link" href={`${home}#contact`}>{t(lang, LAW.nav.contact)}</a>
        <a class="nav-link" href={insightsPath(lang)}>{t(lang, SITE.ui.insightsNav)}</a>
        <a class="nav-link" href={`${home}#media`}>{t(lang, SITE.ui.mediaNav)}</a>
        <a
          class="social-link social-link-nav"
          href={SITE.social.facebook.url}
          target="_blank"
          rel="noreferrer"
          aria-label={t(lang, SITE.social.facebook.label)}
          title={t(lang, SITE.social.facebook.label)}
        >
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M13.7 21v-8h2.7l.4-3.1h-3.1V7.92c0-.9.25-1.51 1.55-1.51h1.66V3.63c-.29-.04-1.27-.13-2.41-.13-2.38 0-4.01 1.45-4.01 4.11V9.9H7.8V13h2.69v8h3.21Z" />
          </svg>
          <span class="sr-only">{t(lang, SITE.social.facebook.label)}</span>
        </a>
        <span class="nav-sep"></span>
        <span class="lang-switch">
          <a href={zhHref} class={lang === 'zh' ? 'lang-active' : 'lang-idle'}>中</a>
          <span class="lang-slash">/</span>
          <a href={enHref} class={lang === 'en' ? 'lang-active' : 'lang-idle'}>EN</a>
        </span>
      </div>

      <div class="nav-mobile">
        <a
          class="social-link social-link-nav"
          href={SITE.social.facebook.url}
          target="_blank"
          rel="noreferrer"
          aria-label={t(lang, SITE.social.facebook.label)}
          title={t(lang, SITE.social.facebook.label)}
        >
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M13.7 21v-8h2.7l.4-3.1h-3.1V7.92c0-.9.25-1.51 1.55-1.51h1.66V3.63c-.29-.04-1.27-.13-2.41-.13-2.38 0-4.01 1.45-4.01 4.11V9.9H7.8V13h2.69v8h3.21Z" />
          </svg>
          <span class="sr-only">{t(lang, SITE.social.facebook.label)}</span>
        </a>
        <span class="lang-switch">
          <a href={zhHref} class={lang === 'zh' ? 'lang-active' : 'lang-idle'}>中</a>
          <span class="lang-slash">/</span>
          <a href={enHref} class={lang === 'en' ? 'lang-active' : 'lang-idle'}>EN</a>
        </span>
        <button id="menu-open" aria-label="Menu" class="menu-btn">
          <span></span>
          <span></span>
          <span class="short"></span>
        </button>
      </div>
    </nav>

    <div id="mobile-menu" class="mobile-menu">
      <div class="mm-head">
        <img class="brand-logo" src="/assets/logo-mark.svg" alt="" width="366" height="220" />
        <button id="menu-close" aria-label="Close" class="mm-close">✕</button>
      </div>
      <div class="mm-links">
        <a class="mm-link" href={`${home}#principal`}>{t(lang, LAW.nav.principal)}</a>
        <a class="mm-link" href={`${home}#team`}>{t(lang, LAW.nav.team)}</a>
        <a class="mm-link" href={`${home}#practice`}>{t(lang, LAW.nav.practice)}</a>
        <a class="mm-link gold" href={`${home}#contact`}>{t(lang, LAW.nav.contact)}</a>
        <a class="mm-link" href={insightsPath(lang)}>{t(lang, SITE.ui.insightsNav)}</a>
        <a class="mm-link" href={`${home}#media`}>{t(lang, SITE.ui.mediaNav)}</a>
      </div>
      <div class="mm-contact">
        <span class="mm-contact-label">Contact</span>
        <a class="mm-email" href={`mailto:${LAW.contact.email}`}>{LAW.contact.email}</a>
        <a class="mm-phone" href={`tel:${LAW.contact.phoneHref}`}>{LAW.contact.phone}</a>
      </div>
    </div>

    <slot />

    <footer style="border-top:1px solid rgba(236,231,223,0.10);">
      <div
        class="shell footer-grid"
        style="padding-block:clamp(40px,6vh,64px) 30px;"
      >
        <div>
          <div style="display:flex; align-items:center; margin-bottom:14px;">
            <img
              src="/assets/logo-mark.svg"
              alt=""
              width="366"
              height="220"
              style="width:44px; height:auto;"
            />
          </div>
          <div class="reading-detail" style="color:#a09a90; margin-bottom:8px;">
            {t(lang, LAW.firm.full)}
          </div>
          <div style="font-size:14px; color:#8f897f; letter-spacing:0.06em;">
            {t(lang, LAW.footer.note)}
          </div>
        </div>
        <div style="display:flex; flex-direction:column; gap:12px;">
          <span
            style="font-family:'IBM Plex Mono',monospace; font-size:12px; letter-spacing:0.22em; color:#8f897f; text-transform:uppercase; margin-bottom:4px;"
          >{t(lang, SITE.footer.navLabel)}</span>
          <a class="footer-link" href={`${home}#principal`}>{t(lang, LAW.nav.principal)}</a>
          <a class="footer-link" href={`${home}#team`}>{t(lang, LAW.nav.team)}</a>
          <a class="footer-link" href={`${home}#practice`}>{t(lang, LAW.nav.practice)}</a>
          <a class="footer-link" href={insightsPath(lang)}>{t(lang, SITE.ui.insightsNav)}</a>
          <a class="footer-link" href={`${home}#media`}>{t(lang, SITE.ui.mediaNav)}</a>
        </div>
        <div style="display:flex; flex-direction:column; gap:12px;">
          <span
            style="font-family:'IBM Plex Mono',monospace; font-size:12px; letter-spacing:0.22em; color:#8f897f; text-transform:uppercase; margin-bottom:4px;"
          >{t(lang, SITE.footer.legalLabel)}</span>
          <a class="footer-link" href={legalPath(lang, 'privacy')}>{t(lang, SITE.legal.navPrivacy)}</a>
          <a class="footer-link" href={legalPath(lang, 'disclaimer')}>{t(lang, SITE.legal.navDisclaimer)}</a>
        </div>
        <div style="display:flex; flex-direction:column; gap:12px;">
          <span
            style="font-family:'IBM Plex Mono',monospace; font-size:12px; letter-spacing:0.22em; color:#8f897f; text-transform:uppercase; margin-bottom:4px;"
          >{t(lang, SITE.footer.contactLabel)}</span>
          <a class="footer-link gold" href={`mailto:${LAW.contact.email}`}>{LAW.contact.email}</a>
          <a
            class="footer-link"
            style="font-family:'IBM Plex Mono',monospace; letter-spacing:0.04em;"
            href={`tel:${LAW.contact.phoneHref}`}
          >{LAW.contact.phone}</a>
          <address class="reading-detail footer-address" style="font-style:normal; color:#8f897f;">
            <span style="display:flex; align-items:baseline; gap:10px; color:#a29b90; margin-bottom:2px;">
              <span>{t(lang, LAW.contact.office)}</span>
              <span style="font-family:'IBM Plex Mono',monospace; font-size:12.5px; color:#8f897f; letter-spacing:0.1em;">
                {LAW.contact.zip}
              </span>
            </span>
            {t(lang, LAW.contact.street)}
          </address>
          <span style="font-family:'IBM Plex Mono',monospace; font-size:13.5px; color:#8f897f;">
            LINE {SITE.line.account}
          </span>
        </div>
      </div>
      <div
        class="shell"
        style="padding-block:22px 40px; display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:14px; border-top:1px solid rgba(236,231,223,0.08);"
      >
        <span style="font-size:13.5px; color:#8f897f;">{t(lang, LAW.footer.copyright)}</span>
      </div>
    </footer>

    <script>
      // 行動版選單開關
      const menu = document.getElementById('mobile-menu');
      const setMenu = (open: boolean) => {
        menu?.classList.toggle('open', open);
        document.body.classList.toggle('menu-open', open);
      };
      document.getElementById('menu-open')?.addEventListener('click', () => setMenu(true));
      document.getElementById('menu-close')?.addEventListener('click', () => setMenu(false));
      menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setMenu(false)));

      // 進場顯示動畫。初始隱藏與 transition 都在 CSS（.reveal-js [data-reveal]），由 <head>
      // 那支 inline script 在首次繪製前決定是否啟用，這裡只負責掛 .is-revealed。
      // 首屏 hero 不走這條路：它由 CSS animation 自己播，不必等這支 deferred module，
      // 否則 LCP 元素（.brand-hero-para）會被壓在 opacity:0 直到 script 執行完。
      if (document.documentElement.classList.contains('reveal-js')) {
        const nodes = Array.from(
          document.querySelectorAll<HTMLElement>('[data-reveal]'),
        ).filter((el) => !el.closest('.brand-hero'));

        // 先一次讀完所有幾何再寫入。讀寫交錯會讓每個節點各觸發一次同步 style flush。
        const limit = window.innerHeight * 0.94;
        const rects = nodes.map((el) => el.getBoundingClientRect());

        const io =
          'IntersectionObserver' in window
            ? new IntersectionObserver(
                (entries) => {
                  entries.forEach((en) => {
                    if (en.isIntersecting) {
                      en.target.classList.add('is-revealed');
                      io?.unobserve(en.target);
                    }
                  });
                },
                { rootMargin: '0px 0px -6% 0px', threshold: 0.03 },
              )
            : null;

        let above = 0;
        nodes.forEach((el, i) => {
          const rect = rects[i];
          // 尺寸為 0 代表當下 display:none（例如行動版隱藏的側欄），
          // getBoundingClientRect 會回 top 0 而被誤判成首屏，交給 observer 處理。
          const rendered = rect.width > 0 || rect.height > 0;
          if (rendered && rect.top < limit) {
            const d = Math.min(above, 7) * 90;
            above += 1;
            window.setTimeout(() => el.classList.add('is-revealed'), 60 + d);
          } else if (io) {
            io.observe(el);
          } else {
            el.classList.add('is-revealed');
          }
        });
      }
    </script>
  </body>
</html>
