---
import Base from '../layouts/Base.astro';
import { SITE } from '../lib/site';
import { t, homePath, legalPath, otherLang, pageTitle, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
  doc: 'privacy' | 'disclaimer';
}

const { lang, doc } = Astro.props;
const legal = doc === 'privacy' ? SITE.legal.privacy : SITE.legal.disclaimer;
---

<Base
  lang={lang}
  title={pageTitle(lang, t(lang, legal.title))}
  description={t(lang, legal.lead)}
  altPath={legalPath(otherLang(lang), doc)}
>
  <main style="max-width:1480px; margin:0 auto; padding:clamp(32px,6vh,72px) clamp(18px,5vw,72px) clamp(56px,9vh,110px);">
    <a href={homePath(lang)} class="back-link"><span>←</span> {t(lang, SITE.ui.back)}</a>

    <div
      style="display:flex; gap:28px; flex-wrap:wrap; margin:clamp(24px,4vh,40px) 0 clamp(32px,5vh,56px); padding-bottom:20px; border-bottom:1px solid rgba(236,231,223,0.12);"
    >
      <a href={legalPath(lang, 'privacy')} class={`legal-tab${doc === 'privacy' ? ' on' : ''}`}>
        {t(lang, SITE.legal.navPrivacy)}
      </a>
      <a href={legalPath(lang, 'disclaimer')} class={`legal-tab${doc === 'disclaimer' ? ' on' : ''}`}>
        {t(lang, SITE.legal.navDisclaimer)}
      </a>
    </div>

    <div style="max-width:80ch;">
      <h1
        style="font-family:Archivo,'Noto Sans TC',sans-serif; font-weight:700; font-size:clamp(1.8rem,3.2vw,2.8rem); line-height:1.2; margin:0 0 20px; color:#F4F0E8;"
      >{t(lang, legal.title)}</h1>
      <div style="font-family:'IBM Plex Mono',monospace; font-size:11.5px; letter-spacing:0.16em; color:#5e5a53; margin-bottom:32px;">
        {t(lang, SITE.legal.updated)}
      </div>
      <p
        style="font-size:clamp(15px,1.15vw,17.5px); line-height:1.95; color:#cfc9bf; margin:0 0 clamp(36px,6vh,60px); font-weight:300; text-wrap:pretty;"
      >{t(lang, legal.lead)}</p>
      <div style="display:flex; flex-direction:column; gap:clamp(28px,4vh,44px);">
        {legal.sections.map((s) => (
          <div class="legal-row">
            <h2 style="font-size:16px; font-weight:500; letter-spacing:0.04em; line-height:1.6; margin:0; color:#ECE7DF;">
              {t(lang, s.h)}
            </h2>
            <p style="font-size:14.5px; line-height:1.95; color:#9a948a; margin:0; font-weight:300; text-wrap:pretty;">
              {t(lang, s.p)}
            </p>
          </div>
        ))}
      </div>
    </div>
  </main>
</Base>
