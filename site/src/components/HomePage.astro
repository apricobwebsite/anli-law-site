---
import Base from '../layouts/Base.astro';
import { LAW, SITE } from '../lib/site';
import {
  t,
  tl,
  homePath,
  insightsPath,
  articlePath,
  practicePath,
  otherLang,
  fmtDate,
  type Lang,
} from '../lib/i18n';
import { getInsights, slugOf } from '../lib/insights';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const teaser = (await getInsights(lang)).slice(0, 3);
const title =
  lang === 'zh'
    ? `${LAW.firm.full.zh}｜${LAW.hero.line1.zh}${LAW.hero.line2.zh}`
    : `${LAW.firm.full.en} — ${LAW.hero.line1.en} ${LAW.hero.line2.en}`;
const mapQuery = encodeURIComponent(LAW.contact.map.query);
const mapEmbed = `https://www.google.com/maps?q=${mapQuery}&output=embed&hl=${lang === 'zh' ? 'zh-TW' : 'en'}`;
const mapDirections = `https://www.google.com/maps/dir/?api=1&destination=${mapQuery}`;
---

<Base lang={lang} title={title} description={t(lang, LAW.hero.para)} altPath={homePath(otherLang(lang))}>
  <main>
    <!-- Hero -->
    <section class="brand-hero" aria-labelledby="brand-hero-title">
      <div class="brand-hero-grid" aria-hidden="true"></div>
      <div class="brand-hero-orbit" aria-hidden="true">
        <span class="orbit orbit-outer"></span>
        <span class="orbit orbit-middle"></span>
        <span class="orbit orbit-inner"></span>
        <span class="orbit-axis orbit-axis-x"></span>
        <span class="orbit-axis orbit-axis-y"></span>
        <span class="orbit-dot"></span>
      </div>

      <div class="brand-hero-content">
        <div data-reveal class="brand-hero-monogram" aria-hidden="true">A</div>

        <div data-reveal class="brand-hero-wordmark">
          <h1 id="brand-hero-title">安理國際<wbr />法律事務所</h1>
          <div class="brand-hero-rule"><span></span></div>
          <p>{LAW.firm.full.en}</p>
        </div>

        <div data-reveal class="brand-hero-promise">
          <span aria-hidden="true"></span>
          <strong>{lang === 'zh' ? '洞見跨越疆界' : 'Foresight beyond borders'}</strong>
        </div>

        <div data-reveal class="brand-hero-principal">
          {t(lang, LAW.principal.name)} <span aria-hidden="true">｜</span> {t(lang, LAW.principal.label)}
        </div>
      </div>
    </section>

    <!-- Principal -->
    <section
      id="principal"
      style="scroll-margin-top:88px; padding:clamp(56px,10vh,124px) clamp(18px,5vw,72px); border-top:1px solid rgba(236,231,223,0.08); background:#0c0c0e;"
    >
      <div style="max-width:1480px; margin:0 auto;">
        <div data-reveal class="kicker" style="margin-bottom:44px;">01 — {t(lang, LAW.principal.label)}</div>
        <div style="display:flex; flex-wrap:wrap; gap:clamp(30px,5vw,80px); align-items:flex-start;">
          <div data-reveal style="flex:0.8 1 280px; min-width:0;">
            <div style="position:relative; aspect-ratio:3/4; border:1px solid rgba(194,163,104,0.30);">
              <img
                src="/assets/yang-color-v2.jpg"
                alt={t(lang, LAW.principal.name)}
                style="position:absolute; inset:12px; width:calc(100% - 24px); height:calc(100% - 24px); object-fit:cover; object-position:60% center; filter:saturate(0.68) sepia(0.11) contrast(1.05) brightness(0.96);"
              />
            </div>
            <div
              style="font-family:'IBM Plex Mono',monospace; font-size:11.5px; letter-spacing:0.18em; color:#6f6a62; margin-top:16px; text-transform:uppercase;"
            >{t(lang, LAW.principal.plate)}</div>
          </div>
          <div style="flex:1.3 1 340px; min-width:0;">
            <h2
              data-reveal
              style="font-family:Archivo,'Noto Sans TC',sans-serif; font-weight:800; font-size:clamp(1.9rem,3.4vw,3.1rem); line-height:1.06; letter-spacing:-0.01em; margin:0 0 14px; color:#F4F0E8;"
            >{t(lang, LAW.principal.name)}</h2>
            <div data-reveal class="reading-detail" style="letter-spacing:0.04em; color:#C2A368; margin-bottom:28px;">
              {t(lang, LAW.principal.title)}
            </div>
            <p
              data-reveal
              class="reading-copy"
              style="color:#cfc9bf; margin:0 0 44px; max-width:64ch; font-weight:400; text-wrap:pretty;"
            >{t(lang, LAW.principal.intro)}</p>

            <!-- 醫療與生醫法制亮點 -->
            <div
              data-reveal
              style="border:1px solid rgba(194,163,104,0.32); background:rgba(194,163,104,0.05); padding:clamp(24px,3vw,40px); margin:0 0 clamp(36px,6vh,52px);"
            >
              <div style="display:flex; align-items:center; gap:10px; margin-bottom:18px;">
                <span
                  style="font-family:'IBM Plex Mono',monospace; font-size:12px; letter-spacing:0.22em; color:#C2A368; text-transform:uppercase;"
                >{t(lang, LAW.medical.kicker)}</span>
                <span style="flex:1; height:1px; background:rgba(194,163,104,0.25);"></span>
              </div>
              <div
                style="font-family:Archivo,'Noto Sans TC',sans-serif; font-weight:700; font-size:clamp(1.3rem,2vw,1.7rem); line-height:1.3; color:#F4F0E8; margin-bottom:14px; text-wrap:pretty;"
              >{t(lang, LAW.medical.title)}</div>
              <p class="reading-detail" style="color:#b8b2a8; margin:0 0 26px; max-width:62ch; font-weight:400; text-wrap:pretty;">
                {t(lang, LAW.medical.para)}
              </p>
              <div
                style="display:grid; grid-template-columns:repeat(auto-fit,minmax(200px,1fr)); gap:1px; background:rgba(194,163,104,0.22); border:1px solid rgba(194,163,104,0.22);"
              >
                {LAW.medical.facts.map((f) => (
                  <div style="background:#0c0c0e; padding:18px 20px;">
                    <div
                      style="font-family:Archivo,'Noto Sans TC',sans-serif; font-weight:700; font-size:clamp(1.05rem,1.5vw,1.35rem); color:#C2A368; margin-bottom:8px; line-height:1.25;"
                    >{t(lang, f.big)}</div>
                    <div style="font-size:13.5px; line-height:1.7; color:#8f897f; letter-spacing:0.02em; text-wrap:pretty;">
                      {t(lang, f.label)}
                    </div>
                  </div>
                ))}
              </div>
            </div>

            <div data-reveal style="margin-bottom:clamp(36px,6vh,52px);">
              <div style="display:flex; align-items:center; gap:10px; margin-bottom:24px;">
                <span
                  style="font-family:'IBM Plex Mono',monospace; font-size:12px; letter-spacing:0.22em; color:#C2A368; text-transform:uppercase;"
                >{t(lang, LAW.principal.specLabel)}</span>
                <span style="flex:1; height:1px; background:rgba(194,163,104,0.25);"></span>
              </div>
              <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(270px,1fr)); gap:clamp(26px,4vw,56px);">
                {LAW.specialties.map((s) => (
                  <div>
                    <div class="reading-detail" style="font-weight:600; letter-spacing:0.05em; color:#ECE7DF; margin-bottom:14px;">
                      {t(lang, s.cat)}
                    </div>
                    {s.lead && (
                      <p class="reading-detail" style="color:#a09a90; margin:0 0 14px; font-weight:400; text-wrap:pretty;">
                        {t(lang, s.lead)}
                      </p>
                    )}
                    <div style="display:flex; flex-direction:column; gap:9px;">
                      {tl(lang, s.items).map((d) => (
                        <div style="display:flex; align-items:baseline; gap:10px;">
                          <span style="width:4px; height:1px; background:#C2A368; flex:none; transform:translateY(-4px);"></span>
                          <span class="reading-detail" style="color:#b8b2a8; font-weight:400;">{d}</span>
                        </div>
                      ))}
                    </div>
                  </div>
                ))}
              </div>
            </div>

            <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(270px,1fr)); gap:clamp(28px,4vw,56px);">
              <div data-reveal>
                <div style="display:flex; align-items:center; gap:10px; margin-bottom:22px;">
                  <span
                    style="font-family:'IBM Plex Mono',monospace; font-size:12px; letter-spacing:0.22em; color:#C2A368; text-transform:uppercase;"
                  >{t(lang, LAW.principal.eduLabel)}</span>
                  <span style="flex:1; height:1px; background:rgba(194,163,104,0.25);"></span>
                </div>
                {LAW.education.map((e) => (
                  <div style="padding:16px 0; border-bottom:1px solid rgba(236,231,223,0.09);">
                    <div class="reading-detail" style="color:#ECE7DF; margin-bottom:6px;">{t(lang, e.school)}</div>
                    <div style="font-family:'IBM Plex Mono',monospace; font-size:14px; line-height:1.7; color:#a09a90; letter-spacing:0.02em;">
                      {t(lang, e.degree)}
                    </div>
                  </div>
                ))}
              </div>
              <div data-reveal>
                <div style="display:flex; align-items:center; gap:10px; margin-bottom:22px;">
                  <span
                    style="font-family:'IBM Plex Mono',monospace; font-size:12px; letter-spacing:0.22em; color:#C2A368; text-transform:uppercase;"
                  >{t(lang, LAW.principal.expLabel)}</span>
                  <span style="flex:1; height:1px; background:rgba(194,163,104,0.25);"></span>
                </div>
                {LAW.experience.map((x) => (
                  <div style="padding:14px 0; border-bottom:1px solid rgba(236,231,223,0.09);">
                    <div class="reading-detail" style="color:#ECE7DF; margin-bottom:5px;">{t(lang, x.org)}</div>
                    <div style="font-size:16px; line-height:1.65; color:#a09a90;">{t(lang, x.role)}</div>
                  </div>
                ))}
              </div>
            </div>

            <!-- 醫藥法律著作選錄 -->
            <div data-reveal style="margin-top:clamp(36px,6vh,52px);">
              <div style="display:flex; align-items:center; gap:10px; margin-bottom:22px;">
                <span
                  style="font-family:'IBM Plex Mono',monospace; font-size:12px; letter-spacing:0.22em; color:#C2A368; text-transform:uppercase;"
                >{t(lang, LAW.principal.pubLabel)}</span>
                <span style="flex:1; height:1px; background:rgba(194,163,104,0.25);"></span>
              </div>
              <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(300px,1fr)); gap:0 clamp(28px,4vw,56px);">
                {LAW.publications.map((p) => (
                  <div style="padding:14px 0; border-bottom:1px solid rgba(236,231,223,0.09);">
                    <div class="reading-detail" style="color:#ECE7DF; margin-bottom:5px; text-wrap:pretty;">{t(lang, p.title)}</div>
                    <div style="font-family:'IBM Plex Mono',monospace; font-size:12.5px; line-height:1.7; color:#8f897f; letter-spacing:0.02em;">
                      {t(lang, p.venue)}
                    </div>
                  </div>
                ))}
              </div>
            </div>

            <!-- 醫法論壇主持・座長 -->
            <div data-reveal style="margin-top:clamp(36px,6vh,52px);">
              <div style="display:flex; align-items:center; gap:10px; margin-bottom:16px;">
                <span
                  style="font-family:'IBM Plex Mono',monospace; font-size:12px; letter-spacing:0.22em; color:#C2A368; text-transform:uppercase;"
                >{t(lang, LAW.forums_h.label)}</span>
                <span style="flex:1; height:1px; background:rgba(194,163,104,0.25);"></span>
              </div>
              <p class="reading-detail" style="color:#a09a90; margin:0 0 18px; max-width:62ch; font-weight:400; text-wrap:pretty;">
                {t(lang, LAW.forums_h.lead)}
              </p>
              <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(300px,1fr)); gap:0 clamp(28px,4vw,56px);">
                {LAW.forums.map((f) => (
                  <div style="padding:14px 0; border-bottom:1px solid rgba(236,231,223,0.09);">
                    <div
                      style="font-family:'IBM Plex Mono',monospace; font-size:12.5px; line-height:1.7; color:#C2A368; letter-spacing:0.04em; margin-bottom:5px;"
                    >{f.year} — {t(lang, f.forum)}</div>
                    <div class="reading-detail" style="color:#b8b2a8; text-wrap:pretty;">{t(lang, f.topic)}</div>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>

        <div data-reveal style="margin-top:clamp(48px,8vh,88px);">
          <div style="display:flex; align-items:center; gap:10px; margin-bottom:26px;">
            <span
              style="font-family:'IBM Plex Mono',monospace; font-size:12px; letter-spacing:0.22em; color:#C2A368; text-transform:uppercase;"
            >{t(lang, LAW.team_h.label)}</span>
            <span style="flex:1; height:1px; background:rgba(194,163,104,0.25);"></span>
          </div>
          <div class="tile-grid" style="--tile-min:240px;">
            {LAW.team.map((m, i) => (
              <article data-reveal class="tile-ruled">
                <div style="position:relative; aspect-ratio:3/4; overflow:hidden; background:#161719; border-bottom:1px solid rgba(236,231,223,0.08);">
                  <img
                    src={m.image}
                    alt={t(lang, m.imageAlt)}
                    width="1254"
                    height="1254"
                    loading="lazy"
                    decoding="async"
                    style="width:100%; height:100%; object-fit:cover; filter:contrast(1.02);"
                  />
                  <div
                    aria-hidden="true"
                    style="position:absolute; top:18px; left:18px; font-family:'IBM Plex Mono',monospace; font-size:11px; letter-spacing:0.2em; color:#c9c4ba; background:rgba(10,10,11,0.72); padding:7px 9px; backdrop-filter:blur(8px);"
                  >
                    {String(i + 1).padStart(2, '0')}
                  </div>
                </div>
                <div class="tile" style="--tile-pt:24px; --tile-px:clamp(18px,2vw,30px); --tile-pb:30px;">
                  <div style="font-size:clamp(20px,1.35vw,23px); font-weight:600; color:#ECE7DF; line-height:1.5; margin-bottom:7px;">
                    {t(lang, m.name)}
                  </div>
                  <div style="font-size:16px; line-height:1.6; letter-spacing:0.06em; color:#C2A368; margin-bottom:20px;">{t(lang, m.role)}</div>
                  {m.expertise && (
                    <div style="margin-bottom:16px;">
                      <div style="font-family:'IBM Plex Mono',monospace; font-size:11px; letter-spacing:0.16em; color:#6f6a62; text-transform:uppercase; margin-bottom:6px;">
                        {t(lang, LAW.team_h.expertiseLabel)}
                      </div>
                      <div class="reading-detail" style="color:#b8b2a8;">{t(lang, m.expertise)}</div>
                    </div>
                  )}
                  <div>
                    <div style="font-family:'IBM Plex Mono',monospace; font-size:11px; letter-spacing:0.16em; color:#6f6a62; text-transform:uppercase; margin-bottom:6px;">
                      {t(lang, LAW.team_h.educationLabel)}
                    </div>
                    <div class="reading-detail" style="color:#a09a90; text-wrap:pretty;">{t(lang, m.education)}</div>
                  </div>
                </div>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- About -->
    <section
      id="about"
      style="scroll-margin-top:88px; padding:clamp(56px,10vh,124px) clamp(18px,5vw,72px); border-top:1px solid rgba(236,231,223,0.08); max-width:1480px; margin:0 auto;"
    >
      <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(300px,1fr)); gap:clamp(28px,5vw,80px);">
        <div data-reveal>
          <div class="kicker" style="margin-bottom:18px;">02 — {t(lang, LAW.about.label)}</div>
          <h2 class="section-title">{t(lang, LAW.about.title)}</h2>
        </div>
        <div data-reveal style="display:flex; flex-direction:column; gap:24px; max-width:62ch; padding-top:6px;">
          <p class="reading-copy" style="color:#cfc9bf; margin:0; font-weight:400; text-wrap:pretty;">
            {t(lang, LAW.about.para1)}
          </p>
          <p class="reading-copy" style="color:#a09a90; margin:0; font-weight:400; text-wrap:pretty;">
            {t(lang, LAW.about.para2)}
          </p>
        </div>
      </div>

      <div
        class="tile-grid"
        style="--tile-gap:1px; margin-top:clamp(48px,7vh,86px); background:rgba(236,231,223,0.10);"
      >
        {SITE.values.map((v, i) => (
          <div data-reveal class="cell-hover tile" style="background:#0a0a0b; --tile-pt:34px; --tile-pb:38px;">
            <div style="font-family:'IBM Plex Mono',monospace; font-size:12px; letter-spacing:0.2em; color:#C2A368; margin-bottom:20px;">
              {String(i + 1).padStart(2, '0')}
            </div>
            <h3 style="font-size:clamp(20px,1.45vw,23px); font-weight:600; margin:0 0 14px; color:#ECE7DF; line-height:1.4;">
              {t(lang, v.title)}
            </h3>
            <p class="reading-detail" style="color:#a09a90; margin:0; font-weight:400; text-wrap:pretty;">
              {t(lang, v.desc)}
            </p>
          </div>
        ))}
      </div>
    </section>

    <!-- Practice -->
    <section
      id="practice"
      style="scroll-margin-top:88px; padding:clamp(56px,10vh,124px) clamp(18px,5vw,72px); border-top:1px solid rgba(236,231,223,0.08); max-width:1480px; margin:0 auto;"
    >
      <div data-reveal style="margin-bottom:52px;">
        <div class="kicker" style="margin-bottom:18px;">03 — {t(lang, LAW.practice_h.label)}</div>
        <h2 class="section-title">{t(lang, LAW.practice_h.title)}</h2>
        <p
          style="display:flex; align-items:baseline; gap:10px; margin:20px 0 0; font-size:14.5px; letter-spacing:0.05em; color:#8f897f;"
        >
          <span style="font-family:'IBM Plex Mono',monospace; color:#C2A368;" aria-hidden="true">↳</span>
          {t(lang, LAW.practice_h.hint)}
        </p>
      </div>
      <div class="tile-grid" style="--tile-min:320px;">
        {LAW.practice.map((p, i) => (
          <a
            data-reveal
            href={practicePath(lang, p.slug)}
            class="practice-card tile tile-ruled"
            style="--tile-pt:32px; --tile-px:clamp(20px,2.4vw,40px); --tile-pb:36px;"
          >
            <div style="font-family:'IBM Plex Mono',monospace; font-size:12px; color:#C2A368; margin-bottom:16px; letter-spacing:0.2em;">
              {String(i + 1).padStart(2, '0')}
            </div>
            <h3 style="font-size:clamp(18px,1.4vw,21px); font-weight:600; margin:0 0 12px; color:#ECE7DF; line-height:1.35;">
              {t(lang, p.title)}
            </h3>
            <p style="font-size:15px; line-height:1.75; color:#a09a90; margin:0 0 22px; font-weight:400; max-width:38ch; text-wrap:pretty;">
              {t(lang, p.desc)}
            </p>
            <div style="display:flex; flex-direction:column; gap:9px; padding-top:18px; border-top:1px solid rgba(236,231,223,0.07);">
              {(SITE.practiceDetail[i] ? tl(lang, SITE.practiceDetail[i]) : []).map((d) => (
                <div style="display:flex; align-items:baseline; gap:10px;">
                  <span style="width:4px; height:1px; background:#C2A368; flex:none; transform:translateY(-4px);"></span>
                  <span style="font-size:14px; line-height:1.6; color:#b8b2a8; font-weight:400;">{d}</span>
                </div>
              ))}
            </div>
            <span class="practice-cta">
              {t(lang, LAW.practiceUi.more)}
              <span class="arr" aria-hidden="true">→</span>
            </span>
          </a>
        ))}
      </div>
    </section>

    <!-- Insights teaser -->
    <section
      id="insights"
      style="scroll-margin-top:88px; padding:clamp(56px,10vh,124px) clamp(18px,5vw,72px); border-top:1px solid rgba(236,231,223,0.08); max-width:1480px; margin:0 auto;"
    >
      <div
        data-reveal
        style="display:flex; flex-wrap:wrap; gap:clamp(20px,4vw,64px); align-items:flex-end; justify-content:space-between; margin-bottom:48px;"
      >
        <div>
          <div class="kicker" style="margin-bottom:18px;">04 — {t(lang, SITE.insights_h.label)}</div>
          <h2 class="section-title">{t(lang, SITE.insights_h.title)}</h2>
        </div>
        <p class="reading-detail" style="color:#9a948a; margin:0; max-width:42ch; font-weight:400;">
          {t(lang, SITE.insights_h.para)}
        </p>
      </div>
      <div class="tile-grid">
        {teaser.map((a) => (
          <a
            data-reveal
            href={articlePath(lang, slugOf(a))}
            class="card-hover tile tile-ruled"
            style="display:block; --tile-pt:28px; --tile-px:clamp(18px,2vw,32px); --tile-pb:32px; text-decoration:none; color:inherit;"
          >
            <div style="display:flex; align-items:baseline; gap:14px; flex-wrap:wrap; margin-bottom:16px;">
              <span
                style="font-family:'IBM Plex Mono',monospace; font-size:12px; letter-spacing:0.2em; color:#C2A368; text-transform:uppercase;"
              >{a.data.category}</span>
              <span style="font-family:'IBM Plex Mono',monospace; font-size:12.5px; color:#8f897f;">
                {fmtDate(lang, a.data.date)}
              </span>
            </div>
            <h3 style="font-size:clamp(20px,1.55vw,24px); font-weight:600; line-height:1.45; margin:0 0 16px; color:#ECE7DF; text-wrap:pretty;">
              {a.data.title}
            </h3>
            <span style="display:inline-flex; align-items:center; gap:8px; font-size:14px; letter-spacing:0.1em; color:#C2A368;">
              {t(lang, SITE.ui.readMore)}
              <span style="font-family:'IBM Plex Mono',monospace;">→</span>
            </span>
          </a>
        ))}
      </div>
      <div data-reveal style="margin-top:40px; padding-top:32px; border-top:1px solid rgba(236,231,223,0.12);">
        <a href={insightsPath(lang)} class="btn-gold">
          {t(lang, SITE.ui.viewAll)}
          <span style="font-family:'IBM Plex Mono',monospace;">→</span>
        </a>
      </div>
    </section>

    <!-- Contact -->
    <section id="contact" class="contact-section">
      <div class="contact-shell">
        <header class="contact-heading">
          <div data-reveal>
            <div class="kicker contact-kicker">05 — {t(lang, LAW.contact.label)}</div>
            <h2>{t(lang, LAW.contact.title)}</h2>
          </div>
          <div data-reveal class="contact-intro">
            <span class="contact-intro-rule" aria-hidden="true"></span>
            <p class="reading-copy">{t(lang, LAW.contact.para)}</p>
          </div>
        </header>

        <div class="contact-composition">
          <div data-reveal class="contact-map-panel">
            <div class="contact-map-meta" aria-hidden="true">
              <span>TAIPEI OFFICE</span>
              <span>NO. 68 · REN'AI RD.</span>
            </div>
            <div class="contact-map-viewport">
              <iframe
                src={mapEmbed}
                title={t(lang, LAW.contact.map.title)}
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
                allowfullscreen
              ></iframe>
              <div class="contact-map-shade" aria-hidden="true"></div>
            </div>

            <div class="contact-location-card">
              <span class="contact-location-number" aria-hidden="true">01</span>
              <div class="contact-location-copy">
                <span class="contact-location-district">{t(lang, LAW.contact.map.district)}</span>
                <div class="contact-location-office">
                  <strong>{t(lang, LAW.contact.office)}</strong>
                  <span>{LAW.contact.zip}</span>
                </div>
                <address>{t(lang, LAW.contact.street)}</address>
              </div>
              <a
                class="contact-map-link"
                href={mapDirections}
                target="_blank"
                rel="noreferrer"
                aria-label={t(lang, LAW.contact.map.directions)}
              >
                <span>{t(lang, LAW.contact.map.directions)}</span>
                <span class="contact-map-link-arrow" aria-hidden="true">↗</span>
              </a>
            </div>
          </div>

          <aside data-reveal class="contact-directory">
            <div class="contact-directory-head">
              <span>{t(lang, LAW.contact.map.contactLabel)}</span>
              <span aria-hidden="true">02</span>
            </div>

            <a class="contact-directory-row" href={`mailto:${LAW.contact.email}`}>
              <span class="contact-directory-label">Email</span>
              <span class="contact-directory-value contact-directory-email">{LAW.contact.email}</span>
              <span class="contact-directory-arrow" aria-hidden="true">↗</span>
            </a>

            <a class="contact-directory-row" href={`tel:${LAW.contact.phoneHref}`}>
              <span class="contact-directory-label">Tel</span>
              <span class="contact-directory-value contact-directory-phone">{LAW.contact.phone}</span>
              <span class="contact-directory-arrow" aria-hidden="true">↗</span>
            </a>

            <div class="contact-consultation">
              <div class="contact-consultation-mark" aria-hidden="true">A</div>
              <p>{t(lang, LAW.contact.map.note)}</p>
              <a href={`mailto:${LAW.contact.email}`} class="btn-gold contact-consultation-cta">
                {t(lang, LAW.contact.cta)}
                <span aria-hidden="true">→</span>
              </a>
            </div>
          </aside>
        </div>
      </div>
    </section>

    <!-- LINE -->
    <section
      id="line"
      style="scroll-margin-top:88px; padding:clamp(56px,9vh,110px) clamp(18px,5vw,72px); border-top:1px solid rgba(236,231,223,0.08);"
    >
      <div
        data-reveal
        style="max-width:1480px; margin:0 auto; display:flex; flex-wrap:wrap; gap:clamp(28px,5vw,72px); align-items:center;"
      >
        <div style="flex:1 1 320px; min-width:0;">
          <div class="kicker" style="margin-bottom:20px;">06 — {t(lang, SITE.line.label)}</div>
          <h2 class="section-title" style="margin-bottom:18px;">{t(lang, SITE.line.title)}</h2>
          <p class="reading-copy" style="color:#a09a90; margin:0 0 30px; max-width:52ch; font-weight:400; text-wrap:pretty;">
            {t(lang, SITE.line.para)}
          </p>
          <div style="display:inline-flex; align-items:center; gap:18px; padding:14px 22px; border:1px solid rgba(236,231,223,0.16);">
            <span
              style="font-family:'IBM Plex Mono',monospace; font-size:11.5px; letter-spacing:0.2em; color:#6f6a62; text-transform:uppercase;"
            >{t(lang, SITE.line.accountLabel)}</span>
            <span style="font-family:'IBM Plex Mono',monospace; font-size:17px; color:#C2A368; letter-spacing:0.04em;">
              {SITE.line.account}
            </span>
          </div>
        </div>
        <div style="flex:0 0 auto; display:flex; flex-direction:column; gap:12px; align-items:center;">
          <div
            style="width:clamp(180px,22vw,220px); aspect-ratio:1/1; border:1px solid rgba(236,231,223,0.16); background-image:repeating-linear-gradient(135deg, rgba(236,231,223,0.05) 0 6px, transparent 6px 12px); display:flex; align-items:center; justify-content:center; padding:20px; text-align:center;"
          >
            <span style="font-family:'IBM Plex Mono',monospace; font-size:12px; letter-spacing:0.18em; color:#8f897f; line-height:1.8;">
              {t(lang, SITE.line.qrNote)}
            </span>
          </div>
          <span style="font-family:'IBM Plex Mono',monospace; font-size:11px; letter-spacing:0.2em; color:#6f6a62; text-transform:uppercase;">
            LINE QR
          </span>
        </div>
      </div>
    </section>
  </main>
</Base>
