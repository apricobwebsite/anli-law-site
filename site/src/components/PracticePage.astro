---
import Base from '../layouts/Base.astro';
import { LAW, SITE } from '../lib/site';
import { t, tl, homePath, practicePath, pageTitle, type Lang } from '../lib/i18n';
import { PRACTICE_CONTENT } from '../lib/practiceContent';

interface Props {
  lang: Lang;
  index: number;
}

const { lang, index } = Astro.props;
const area = LAW.practice[index];
const scope = SITE.practiceDetail[index];
const content = PRACTICE_CONTENT[area.slug];
const home = homePath(lang);
const others = LAW.practice.filter((p) => p.slug !== area.slug);
const num = String(index + 1).padStart(2, '0');
const title = pageTitle(lang, t(lang, area.title));
const description = content ? t(lang, content.metaDesc) : t(lang, area.desc);

// SEO 結構化資料：LegalService ＋ FAQPage
const siteUrl = Astro.site?.href?.replace(/\/$/, '') ?? '';
const jsonLd: object[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'LegalService',
    name: t(lang, LAW.firm.full),
    description,
    url: `${siteUrl}${practicePath(lang, area.slug)}`,
    telephone: LAW.contact.phone,
    email: LAW.contact.email,
    address: {
      '@type': 'PostalAddress',
      streetAddress: t(lang, LAW.contact.street),
      addressLocality: 'Taipei',
      postalCode: LAW.contact.zip,
      addressCountry: 'TW',
    },
    areaServed: 'TW',
    knowsAbout: t(lang, area.title),
  },
];
if (content && content.faq.length > 0) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: content.faq.map((f) => ({
      '@type': 'Question',
      name: t(lang, f.q),
      acceptedAnswer: { '@type': 'Answer', text: t(lang, f.a) },
    })),
  });
}
---

<Base
  lang={lang}
  title={title}
  description={description}
  altPath={practicePath(lang === 'zh' ? 'en' : 'zh', area.slug)}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} slot="head" />
  <main style="max-width:1480px; margin:0 auto; padding:clamp(32px,6vh,72px) clamp(18px,5vw,72px) clamp(56px,9vh,110px);">
    <a href={`${home}#practice`} class="back-link"><span>←</span> {t(lang, LAW.practiceUi.breadcrumb)}</a>

    <!-- 標題區 -->
    <header style="max-width:78ch; margin:clamp(24px,4vh,44px) 0 0;">
      <div class="kicker" style="margin-bottom:20px;">{num} — {t(lang, LAW.practice_h.label)}</div>
      <h1
        style="font-family:Archivo,'Noto Sans TC',sans-serif; font-weight:700; font-size:clamp(1.9rem,3.8vw,3.2rem); line-height:1.18; letter-spacing:-0.015em; margin:0 0 24px; color:#F4F0E8; text-wrap:pretty;"
      >{t(lang, area.title)}</h1>
      <p class="reading-copy-lead" style="color:#C2A368; margin:0 0 36px; font-weight:400; text-wrap:pretty;">
        {t(lang, area.desc)}
      </p>
      <div style="height:1px; background:rgba(236,231,223,0.14);"></div>
      {content && (
        <div style="margin-top:36px; display:flex; flex-direction:column; gap:22px;">
          {content.intro.map((p) => (
            <p class="reading-copy" style="color:#cfc9bf; margin:0; font-weight:400; max-width:68ch; text-wrap:pretty;">
              {t(lang, p)}
            </p>
          ))}
        </div>
      )}
    </header>

    <!-- 服務內容 -->
    {scope && (
      <section style="margin-top:clamp(48px,7vh,80px);">
        <div style="display:flex; align-items:center; gap:10px; margin-bottom:24px;">
          <span
            style="font-family:'IBM Plex Mono',monospace; font-size:12px; letter-spacing:0.22em; color:#C2A368; text-transform:uppercase;"
          >{t(lang, LAW.practiceUi.scopeTitle)}</span>
          <span style="flex:1; height:1px; background:rgba(194,163,104,0.25);"></span>
        </div>
        <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(260px,1fr)); gap:12px 40px; max-width:960px;">
          {tl(lang, scope).map((d) => (
            <div style="display:flex; align-items:baseline; gap:10px;">
              <span style="width:4px; height:1px; background:#C2A368; flex:none; transform:translateY(-4px);"></span>
              <span class="reading-detail" style="color:#b8b2a8; font-weight:400;">{d}</span>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- 常見案件類型 -->
    {content && content.cases.length > 0 && (
      <section style="margin-top:clamp(48px,7vh,80px);">
        <div style="display:flex; align-items:center; gap:10px; margin-bottom:28px;">
          <span
            style="font-family:'IBM Plex Mono',monospace; font-size:12px; letter-spacing:0.22em; color:#C2A368; text-transform:uppercase;"
          >{t(lang, LAW.practiceUi.casesTitle)}</span>
          <span style="flex:1; height:1px; background:rgba(194,163,104,0.25);"></span>
        </div>
        <div class="tile-grid" style="--tile-gap:1px; background:rgba(236,231,223,0.10);">
          {content.cases.map((c) => (
            <div class="cell-hover tile" style="background:#0a0a0b; --tile-pt:26px; --tile-px:clamp(18px,2vw,30px); --tile-pb:30px;">
              <h3 style="font-size:clamp(17px,1.3vw,20px); font-weight:600; margin:0 0 10px; color:#ECE7DF; line-height:1.4;">
                {t(lang, c.term)}
              </h3>
              <p style="font-size:15px; line-height:1.8; color:#a09a90; margin:0; font-weight:400; text-wrap:pretty;">
                {t(lang, c.desc)}
              </p>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- 常見問題 -->
    {content && content.faq.length > 0 && (
      <section style="margin-top:clamp(48px,7vh,80px); max-width:860px;">
        <div style="display:flex; align-items:center; gap:10px; margin-bottom:24px;">
          <span
            style="font-family:'IBM Plex Mono',monospace; font-size:12px; letter-spacing:0.22em; color:#C2A368; text-transform:uppercase;"
          >{t(lang, LAW.practiceUi.faqTitle)}</span>
          <span style="flex:1; height:1px; background:rgba(194,163,104,0.25);"></span>
        </div>
        <div style="border-bottom:1px solid rgba(236,231,223,0.12);">
          {content.faq.map((f) => (
            <details class="practice-faq">
              <summary>
                <span>{t(lang, f.q)}</span>
                <span class="faq-mark" aria-hidden="true">＋</span>
              </summary>
              <div class="faq-body">
                <p class="reading-detail" style="color:#a09a90; margin:0; font-weight:400; text-wrap:pretty;">
                  {t(lang, f.a)}
                </p>
              </div>
            </details>
          ))}
        </div>
      </section>
    )}

    <!-- 諮詢 CTA -->
    <section class="practice-cta-box">
      <div style="display:flex; flex-wrap:wrap; gap:clamp(24px,4vw,64px); align-items:center; justify-content:space-between;">
        <div style="flex:1 1 380px; min-width:0;">
          <h2
            style="font-family:Archivo,'Noto Sans TC',sans-serif; font-weight:700; font-size:clamp(1.4rem,2.2vw,1.9rem); line-height:1.3; margin:0 0 14px; color:#F4F0E8; text-wrap:pretty;"
          >{t(lang, LAW.practiceUi.ctaTitle)}</h2>
          <p class="reading-detail" style="color:#a09a90; margin:0; max-width:56ch; font-weight:400; text-wrap:pretty;">
            {t(lang, LAW.practiceUi.ctaPara)}
          </p>
        </div>
        <div style="display:flex; flex-direction:column; gap:14px; align-items:flex-start;">
          <a href={`mailto:${LAW.contact.email}`} class="btn-gold">
            {t(lang, LAW.contact.cta)}
            <span style="font-family:'IBM Plex Mono',monospace;">→</span>
          </a>
          <a
            href={`tel:${LAW.contact.phoneHref}`}
            style="font-family:'IBM Plex Mono',monospace; font-size:15px; color:#b8b2a8; text-decoration:none; letter-spacing:0.04em; padding:6px 0;"
          >{LAW.contact.phone}</a>
        </div>
      </div>
    </section>

    <!-- 其他執業領域（站內連結） -->
    <section style="margin-top:clamp(48px,7vh,80px);">
      <div
        style="font-family:'IBM Plex Mono',monospace; font-size:12px; letter-spacing:0.22em; color:#C2A368; text-transform:uppercase; margin-bottom:22px;"
      >{t(lang, LAW.practiceUi.otherTitle)}</div>
      <div style="display:flex; flex-wrap:wrap; gap:10px;">
        {others.map((p) => (
          <a href={practicePath(lang, p.slug)} class="chip-link">{t(lang, p.title)}</a>
        ))}
      </div>
    </section>

    <p style="margin:clamp(40px,6vh,64px) 0 0; font-size:13.5px; color:#8f897f; letter-spacing:0.02em;">
      {t(lang, LAW.practiceUi.note)}
    </p>
  </main>
</Base>
